{
  "name": "react-photo-gallery-adaptive",
  "version": "1.0.2",
  "description": "Adaptive React photo gallery with automatic aspect-ratio calculation, full-screen lightbox, and responsive grid modal.",
  "scripts": {
    "dev": "vite --config vite.demo.config.mjs --host 0.0.0.0 --port 4173",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.mjs",
    "preview": "vite preview --config vite.demo.config.mjs --host 0.0.0.0 --port 4173",
    "prepublishOnly": "npm run build"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "files": [
    "dist",
    "index.d.ts"
  ],
  "keywords": [
    "react",
    "react-component",
    "gallery",
    "photo-gallery",
    "image-gallery",
    "react-image-gallery",
    "lightbox",
    "justified-gallery",
    "justified-layout",
    "masonry",
    "image-grid",
    "aspect-ratio",
    "responsive",
    "adaptive",
    "nextjs",
    "typescript"
  ],
  "author": "niqeru",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niqeru/react-photo-gallery-adaptive.git"
  },
  "bugs": {
    "url": "https://github.com/niqeru/react-photo-gallery-adaptive/issues"
  },
  "homepage": "https://niqeru.github.io/react-photo-gallery-adaptive/",
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  }
}
